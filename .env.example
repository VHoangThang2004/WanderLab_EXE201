# ═══════════════════════════════════════════════════════════════
# WanderLab Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Required for auth, database, storage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI Chatbot (vRouter) ──────────────────────────────────────
# These are SERVER-SIDE only (no VITE_ prefix) → never exposed to browser
# API key for vRouter authentication
# vRouter is a standalone system for using multi-model LLM
# API/Quota management at: https://v-router.fpt.ovh/client

#------------------------------------------
API_LLM_AI=
# Full endpoint URL (e.g. https://v-router.fpt.ovh/v1/chat/completions)
API_LLM_ENDPOINT=
# Model ID on vRouter (e.g. WanderLab)
API_LLM_MODEL=
#------------------------------------------


# ── Google Gemini (legacy, deprecated — use vRouter instead) ──
# VITE_GEMINI_API_KEY=

# ── VNPay Sandbox (optional) ──────────────────────────────────
# VITE_VNPAY_MERCHANT_ID=
